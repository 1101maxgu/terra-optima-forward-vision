# GeoViva backend configuration. Copy to .env.local for local dev; set the same names in
# Vercel -> Project "geoviva" -> Settings -> Environment Variables for deployments.
# With DATABASE_URL / GEOVIVA_ENCRYPTION_KEY / SUPABASE_* unset, every /api endpoint answers
# 503 {"error":"backend_not_configured"} and the static app keeps working on browser storage.

# ---------- server only (never prefix with VITE_) ----------

# Postgres 15+ connection string. Supabase: use the *transaction pooler* URI (port 6543).
# Neon: use the pooled ("-pooler") host. TLS is required unless the URL has sslmode=disable.
DATABASE_URL=postgres://postgres.xxxxxxxx:password@aws-0-ca-central-1.pooler.supabase.com:6543/postgres

# 32 random bytes, base64. Encrypts LoRaWAN API keys (AES-256-GCM) and keys the HMAC used for
# device tokens / claim codes / webhook secrets. Changing it invalidates all of those.
#   openssl rand -base64 32
GEOVIVA_ENCRYPTION_KEY=

# Supabase Auth. SUPABASE_URL enables JWKS verification (new asymmetric signing keys) and the
# issuer check; SUPABASE_JWT_SECRET is only needed for projects still on the legacy HS256 secret.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=

# Comma-separated browser origins allowed by CORS (same-origin calls need no entry).
GEOVIVA_ALLOWED_ORIGINS=https://geoviva-tau.vercel.app,http://localhost:5173

# Public base URL used in webhook / ingest URLs handed to TTS and devices. Defaults to the request origin.
GEOVIVA_PUBLIC_API_URL=https://geoviva-tau.vercel.app

# Bearer token for POST /api/admin/devices (factory provisioning of ESP32 claim codes). Leave empty to disable.
#   openssl rand -base64 32
GEOVIVA_ADMIN_TOKEN=

# ---------- client (bundled into the browser; public values only) ----------

# Origin that serves /api. Setting it switches the "My farm" dataset to the server.
VITE_API_URL=https://geoviva-tau.vercel.app
